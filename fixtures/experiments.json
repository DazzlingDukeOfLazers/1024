  {
    "id": "nearly-equal",
    "name": "Subtracting nearly equal numbers",
    "unit": "m",
    "steps": [
      {
        "op": "set",
        "value": {
          "numerator": "10000000000000001",
          "denominator": "1"
        }
      },
      {
        "op": "sub",
        "value": {
          "numerator": "10000000000000000",
          "denominator": "1"
        }
      }
    ],
    "kind": "arithmetic",
    "note": "The exact answer is 1 m. 10^16 + 1 is not representable in binary64, so the difference of two nearly equal numbers is entirely made of the error in the first one."
  },
