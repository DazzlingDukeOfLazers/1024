  {
    "id": "proton",
    "name": "Proton",
    "categories": [
      "physics",
      "subatomic"
    ],
    "quantities": {
      "diameter": {
        "dimension": "length",
        "unit": "fm",
        "representative": "1.6828",
        "range": {
          "min": "1.679",
          "max": "1.687"
        },
        "approximation": "measured",
        "source": "CODATA 2018: proton rms charge radius 0.8414(19) fm, doubled",
        "note": "A proton has no edge. \"Diameter\" here means twice the root-mean-square charge radius, and the range is the published standard uncertainty. CODATA 2014 gave 0.8751 fm from electron scattering; muonic-hydrogen spectroscopy disagreed, and CODATA 2018 moved. The number changed because the measurement did, not the proton."
      }
    },
    "relations": [
      {
        "type": "part-of",
        "targetId": "hydrogen-atom"
      }
    ]
  },
  {
    "id": "hydrogen-atom",
    "name": "Hydrogen atom",
    "categories": [
      "physics",
      "chemistry",
      "atomic"
    ],
    "quantities": {
      "diameter": {
        "dimension": "length",
        "unit": "pm",
        "representative": "105.835",
        "range": {
          "min": "105.835",
          "max": "240"
        },
        "approximation": "representative",
        "source": "Twice the Bohr radius (CODATA 2018: a0 = 52.9177210903 pm)",
        "note": "An atom has no edge either, so its size depends on which convention you ask for. The lower bound is twice the Bohr radius; the upper is twice the Bondi van der Waals radius of 120 pm. Both describe the same hydrogen atom."
      }
    },
    "relations": [
      {
        "type": "part-of",
        "targetId": "water-molecule"
      }
    ]
  },
  {
    "id": "dna-helix",
    "name": "DNA double helix",
    "aliases": [
      "DNA"
    ],
    "categories": [
      "biology",
      "molecular"
    ],
    "quantities": {
      "width": {
        "dimension": "length",
        "unit": "nm",
        "representative": "2",
        "approximation": "representative",
        "source": "Arnott & Hukins 1972, optimised B-DNA fibre-diffraction parameters; 20.4 Å as recorded by BioNumbers BNID 105243",
        "note": "Width of the B-form helix. A helix has no edge any more than an atom does — the figure depends on where the surface of the phosphate backbone is taken to be. 2 nm is the rounded conventional value; the fibre-diffraction figure the source records is 20.4 Å. Left representative rather than measured because the rounding, not the diffraction, is what this number is."
      }
    },
    "relations": [
      {
        "type": "contained-by",
        "targetId": "skin-cell"
      }
    ]
  },
